{
  "name": "@metafor/space",
  "description": "MetaFor particle system",
  "version": "1.3.22",
  "type": "module",
  "license": "MIT",
  "author": "zavx0z",
  "homepage": "https://github.com/zavx0z/metafor-space",
  "repository": {
    "type": "git",
    "url": "https://github.com/zavx0z/metafor-space.git"
  },
  "keywords": [
    "metafor",
    "fsm",
    "finite state machine",
    "html template",
    "actor system"
  ],
  "main": "metafor.js",
  "module": "metafor.js",
  "types": "metafor.d.ts",
  "files": [
    "metafor.js",
    "types/*.d.ts",
    "validator",
    "types",
    "core/web/component.js",
    "dom/html/html.d.ts",
    "dom/html/html.js",
    "dom/html/directives/*",
    "dom/html/directive.js",
    "dom/html/async-directive.js",
    "dom/html/types/*"
  ],
  "exports": {
    ".": {
      "types": "./metafor.d.ts",
      "default": "./metafor.js"
    },
    "./validator": "./validator/index.js",
    "./core/web/component": "./core/web/component.js"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "17.3.0",
    "@types/bun": "latest",
    "happy-dom": "^17.4.4",
    "puppeteer": "^24.6.1",
    "elkjs": "^0.10.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "scripts": {
    "publish-pkg": "bun run ./scripts/updateVersion.ts ./ && bun publish",
    "docs": "bunx typedoc",
    "rules": "bunx rimraf typedoc-rules && bunx typedoc --options ./rules.jsonc && bunx concat-md --hide-anchor-links typedoc-rules > rule.mdc && bunx rimraf typedoc-rules",
    "test": "bun test core/tests",
    "test[watch]": "bun test tests --watch",
    "test:lifecycle": "bun test tests/lifecycle",
    "test:lifecycle:withoutAction": "bun test tests/lifecycle/withoutAction.spec.ts",
    "test:lifecycle:withAction": "bun test tests/lifecycle/withAction.spec.ts",
    "test:actions": "bun test tests/actions.spec.ts",
    "test:core": "bun test tests/core.spec.ts",
    "test:core[debug]": "bun test tests/core.spec.ts --debug",
    "test:core[watch]": "bun test tests/core.spec.ts --watch",
    "test:enum": "bun test tests/enum.spec.ts",
    "test:isNull": "bun test tests/isNull.spec.ts",
    "test:metafor": "bun test tests/metafor.spec.ts",
    "test:onTransition": "bun test tests/onTransition.spec.ts",
    "test:pipe": "bun test tests/pipe.spec.ts",
    "test:state": "bun test tests/state.spec.ts",
    "test:sync": "bun test tests/sync.spec.ts",
    "test:transitions:lock": "bun test tests/transitions.lock.spec.ts",
    "test:update": "bun test tests/update.spec.ts",
    "test:view": "bun test tests/view.spec.ts",

    "test:serialize": "bun test tests/serialize.spec.ts",
    "test:dev": "bun test tests/dev.spec.ts",
    "test:extract": "bun test tests/extract.spec.ts",

    "test:html": "bun test ./html",
    "test:html[watch]": "bun test tests/html --watch",
    "test:html:marker": "bun test tests/html/marker.spec.ts",
    "test:html:marker[debug]": "bun test tests/html/marker.spec.ts --inspect-brk",
    "test:html:marker[watch]": "bun test tests/html/marker.spec.ts --watch",
    "test:html:text": "bun test tests/html/text.spec.ts",
    "test:html:text[debug]": "bun test tests/html/text.spec.ts --inspect-brk",
    "test:html:text[watch]": "bun test tests/html/text.spec.ts --watch",
