    "test:html:updates": "bun test tests/html/updates.spec.ts",
    "test:html:updates[debug]": "bun test tests/html/updates.spec.ts --inspect-brk",
    "test:html:updates[watch]": "bun test tests/html/updates.spec.ts --watch",
    "test:html:compiled": "bun test tests/html/compiled.spec.ts",
    "test:html:compiled[debug]": "bun test tests/html/compiled.spec.ts --inspect-brk",
