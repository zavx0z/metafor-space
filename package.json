{
  "name": "@metafor/space",
  "version": "1.3.22",
  "author": "zavx0z",
  "repository": {
    "type": "git",
    "url": "https://github.com/zavx0z/metafor-space.git"
  },
  "main": "metafor.js",
  "module": "metafor.js",
  "devDependencies": {
    "@happy-dom/global-registrator": "18.0.1",
    "@types/bun": "^1.2.19",
    "@types/three": "0.178.1",
    "dts-bundle-generator": "^9.5.1",
    "elkjs": "0.10.0",
    "happy-dom": "18.0.1",
    "puppeteer": "^24.15.0",
    "three": "0.178.0"
  },
  "peerDependencies": {
    "typescript": "^5.8.3"
  },
  "exports": {
    ".": {
      "types": "./metafor.d.ts",
      "default": "./metafor.js"
    }
  },
  "description": "MetaFor particle system",
  "files": [
    "metafor.js"
  ],
  "homepage": "https://github.com/zavx0z/metafor-space",
  "keywords": [
    "metafor",
    "fsm",
    "finite state machine",
    "html template",
    "actor system"
  ],
  "license": "MIT",
  "scripts": {
    "upd": "bun update --latest && bun i",
    "run": "bun index.server.ts",
    "metafor:dev": "bun ./scripts/metafor.build.ts",
    "build": "bun index.build.ts",
    "publish-pkg": "bun run ./scripts/updateVersion.ts ./ && bun publish",
    "TEST:GRAPH-----------": "bun test graph/*",
    "test:graph-layout": "bun test graph/graph-layout.spec.ts",
    "test:graph-state": "bun test graph/graph-state.spec.ts",
    "test:graph-transition": "bun test graph/graph-transition.spec.ts"
  },
  "type": "module",
  "types": "metafor.d.ts"
}
