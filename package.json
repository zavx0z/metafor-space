    "test:html:security": "bun test tests/html/security.spec.ts",
    "test:html:security[debug]": "bun test tests/html/security.spec.ts --inspect-brk",
    "test:html:security[watch]": "bun test tests/html/security.spec.ts --watch",
    "test:html:spoof": "bun test tests/html/spoof.spec.ts",
    "test:html:spoof[debug]": "bun test tests/html/spoof.spec.ts --inspect-brk",
    "test:html:spoof[watch]": "bun test tests/html/spoof.spec.ts --watch",
    "test:html:warnings": "bun test tests/html/warnings.spec.ts",
