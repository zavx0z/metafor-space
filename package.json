    "test:html:warnings[watch]": "bun test tests/html/warnings.spec.ts --watch",
    "test:html:static": "bun test static.spec.ts",
    "test:html:static[debug]": "bun test static.spec.ts --inspect-brk",
    "test:html:static[watch]": "bun test static.spec.ts --watch",
    "test:directives": "bun test tests/directives",
    "test:directives[debug]": "bun test tests/directives --inspect-brk",
    "test:directives[watch]": "bun test tests/directives --watch",
    "test:directives:cache": "bun test directives/cache.spec.ts",
    "test:directives:cache[debug]": "bun test directives/cache.spec.ts --inspect-brk",
    "test:directives:cache[watch]": "bun test directives/cache.spec.ts --watch",
