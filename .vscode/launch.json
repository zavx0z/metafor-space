{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Debug File",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false,
            "env": {
                "NODE_ENV": "development"
            }
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Run File",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "noDebug": true,
            "watchMode": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Run All Tests",
            "program": "bun",
            "args": ["test"],
            "cwd": "${workspaceFolder}",
            "noDebug": true,
            "watchMode": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Run Tests (Watch)",
            "program": "bun",
            "args": ["test", "--watch"],
            "cwd": "${workspaceFolder}",
            "noDebug": true,
            "watchMode": true
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Run Current Test File",
            "program": "bun",
            "args": ["test", "${file}"],
            "cwd": "${workspaceFolder}",
            "noDebug": true,
            "watchMode": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Debug Tests",
            "program": "bun",
            "args": ["test", "${file}", "--inspect"],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false,
            "env": {
                "NODE_ENV": "test"
            }
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "attach",
            "name": "Attach Bun",
            "url": "ws://localhost:6499/",
            "stopOnEntry": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "neverOpen",
            "request": "launch",
            "name": "Debug Tests with Timeout",
            "program": "bun",
            "args": ["test", "${file}", "--inspect", "--timeout", "30000"],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false,
            "env": {
                "NODE_ENV": "test"
            }
        }
    ]
}